// Minimal defaults -- resource allocation, executor, and GCP Batch specifics
// are expected to be supplied by your own execution wrapper/config.
// Everything here is safely overridable by whatever profile/config you layer
// on top (e.g. `nextflow run main.nf -c your_batch.config ...`).

process {
    cpus   = 4
    memory = '4 GB'

    withName: 'MAKE_WINDOWS' {
        cpus   = 1
        memory = '2 GB'
    }
    withName: 'AGGREGATE' {
        cpus   = 1
        memory = '2 GB'
    }
}

params {
    samplesheet  = null
    window_size  = 20_000_000
    softclip_min = 30
    threads      = 4
    outdir       = 'results'
}
