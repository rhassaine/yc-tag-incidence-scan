// Minimal defaults -- resource allocation, executor, and GCP Batch specifics
// are expected to be supplied by your own execution wrapper/config.
// Everything here is safely overridable by whatever profile/config you layer
// on top (e.g. `nextflow run main.nf -c your_batch.config ...`).

process {
    cpus   = 2
    memory = '4 GB'

    withName: 'MAKE_WINDOWS' {
        cpus   = 1
        memory = '2 GB'
    }
    withName: 'AGGREGATE' {
        cpus   = 1
        memory = '2 GB'
    }
}

params {
    input        = null
    window_size  = 100_000_000
    threads      = 2
    outdir       = 'results'

    // contigs at/below window_size but ABOVE this threshold are still
    // "real" chromosomes (e.g. chr16-22 at a 100Mb window_size) and each
    // gets its own dedicated task, unsplit. Only contigs at/below this
    // threshold (genuinely tiny ALT/HLA/decoy scaffolds) get batched
    // together. Without this distinction, a handful of real ~50-90Mb
    // chromosomes ended up bundled into the same task as thousands of
    // KB-scale scaffolds, making that one task process far more data
    // than any other and become the long-pole straggler for the whole
    // run. Default (5Mb) sits comfortably below the smallest real human
    // chromosome (chr21, ~46.7Mb) -- worth checking against your specific
    // reference's contig sizes if using a non-human or unusual genome.
    small_contig_threshold = 5_000_000

    // contigs at/below small_contig_threshold (e.g. ALT/HLA/decoy
    // scaffolds -- a reference can have thousands of these) are batched
    // into groups of this many contig names per task, rather than one
    // task each -- otherwise task count is driven by contig count, not
    // window_size
    small_contig_batch = 200

    // overridable centrally -- change here rather than per-process
    samtools_container = 'quay.io/biocontainers/samtools:1.22.1--h96c455f_0'
    base_container      = 'quay.io/biocontainers/gawk:5.1.0--2'
}

