// Minimal defaults -- resource allocation, executor, and GCP Batch specifics
// are expected to be supplied by your own execution wrapper/config.
// Everything here is safely overridable by whatever profile/config you layer
// on top (e.g. `nextflow run main.nf -c your_batch.config ...`).

process {
    cpus   = 2
    memory = '4 GB'

    withName: 'MAKE_WINDOWS' {
        cpus   = 1
        memory = '2 GB'
    }
    withName: 'AGGREGATE' {
        cpus   = 1
        memory = '2 GB'
    }
}

params {
    input  = null
    window_size  = 100_000_000
    threads      = 2
    outdir       = 'results'

    // overridable centrally -- change here rather than per-process
    samtools_container = 'quay.io/biocontainers/samtools:1.22.1--h96c455f_0'
    base_container     = 'quay.io/biocontainers/gawk:5.1.0--2'
}
